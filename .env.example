# ---- gamebrain configuration ----
# Copy this file to `.env` and edit. NEVER commit the real `.env`.

# Which pack to load. A pack is a folder with pack.json + kb.json.
PACK_DIR=./packs/default

# =========================================================================
# LLM - connect your own model
# =========================================================================
# Two wire formats are supported. Set LLM_API to pick one.
#
#   LLM_API=ollama   POST {LLM_URL}/api/chat
#                    Ollama's native format. The default.
#
#   LLM_API=openai   POST {LLM_URL}/chat/completions
#                    The OpenAI-compatible format. Use this for OpenRouter,
#                    OpenAI, vLLM, LM Studio, llama.cpp, LiteLLM, Groq,
#                    Together, or any other OpenAI-compatible provider.
#
# The tool-calling schema is identical in both, so the same pack works
# with either. See docs/INSTALL.md section 3 for provider examples.
LLM_API=ollama

# The base URL of your model server. NOTE: for LLM_API=openai this is the
# BASE, not the full path - the engine appends /chat/completions for you.
# For LLM_API=ollama the engine appends /api/chat.
LLM_URL=http://127.0.0.1:11434

# The model name, exactly as your server knows it.
LLM_MODEL=qwen3:8b

# API key. Sent as "Authorization: Bearer <key>".
# Leave EMPTY for a local model that needs no auth (Ollama on localhost).
LLM_API_KEY=

# If your provider uses a different header name (e.g. Anthropic-style
# "x-api-key"), set it here and it will be used INSTEAD of Authorization.
# Leave empty for the standard Bearer header.
LLM_API_KEY_HEADER=

# Optional tuning
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=0

# =========================================================================
# Text to speech (OPTIONAL)
# =========================================================================
# Any endpoint implementing OpenAI's /v1/audio/speech.
# The easiest is speaches:  docker run -d -p 8000:8000 \
#   ghcr.io/speaches-ai/speaches:latest \
#   --model-id speaches-ai/Kokoro-82M-v1.0-ONNX
# Leave TTS_URL empty to run without speech.
TTS_URL=
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_bella
TTS_SPEED=1.0

# =========================================================================
# Escalation agent (OPTIONAL)
# =========================================================================
# A more capable agent the assistant can ask for things it cannot know.
# Any OpenAI-compatible /v1/chat/completions endpoint.
# Leave empty to disable.
HERMES_URL=
HERMES_KEY=

# =========================================================================
# Service
# =========================================================================
PORT=8095
# Bump this whenever you deploy a new UI build, so browsers pick it up.
UI_BUILD=dev
